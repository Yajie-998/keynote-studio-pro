{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keynote-studio-pro.local/schemas/project.schema.json",
  "title": "Keynote Studio Project",
  "type": "object",
  "required": [
    "title",
    "theme",
    "canvas",
    "fps",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 240
        },
        "safeMargin": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        }
      },
      "additionalProperties": false
    },
    "fps": {
      "type": "integer",
      "enum": [
        24,
        25,
        30,
        50,
        60
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "video": {
          "type": "boolean"
        },
        "editablePptx": {
          "type": "boolean"
        },
        "highFidelityPptx": {
          "type": "boolean"
        },
        "directory": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "credit": {
            "type": "string"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "scene.schema.json"
      }
    }
  },
  "additionalProperties": true
}