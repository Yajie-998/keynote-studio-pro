{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keynote-studio-pro.local/schemas/scene.schema.json",
  "title": "Keynote Scene",
  "type": "object",
  "required": [
    "id",
    "duration",
    "background",
    "elements"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "background": {
      "type": "string"
    },
    "layout": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "text",
              "image",
              "shape",
              "video"
            ]
          },
          "text": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "fontSize": {
            "type": "number"
          },
          "fontFace": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "bold": {
            "type": "boolean"
          },
          "align": {
            "enum": [
              "left",
              "center",
              "right"
            ]
          },
          "fit": {
            "enum": [
              "contain",
              "cover"
            ]
          },
          "shape": {
            "enum": [
              "rect",
              "roundRect",
              "ellipse",
              "line"
            ]
          },
          "radius": {
            "type": "number"
          },
          "opacity": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time",
          "animation"
        ],
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "animation": {
            "type": "string"
          },
          "sound": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "src"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "role": {
            "enum": [
              "bgm",
              "sfx",
              "vo",
              "amb"
            ]
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "fadeIn": {
            "type": "number",
            "minimum": 0
          },
          "fadeOut": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": true
}